[Unit]
Description=snens web client (snens-web :5180 → /api :7420)
Documentation=https://snens.svuvi.ch/docs/surfaces.html
After=network.target snens.service
Wants=snens.service

[Service]
Type=simple
# Клиент — один бинарь со статикой рядом (`web/`), а не dev-сервер vite:
# в поставке не нужны ни node, ни npx. Бинарь и каталог клиента ставит релиз
# веб-клиента (`scripts/web-release.sh`), здесь только запуск.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SNENS_WEB_LISTEN=127.0.0.1:5180
Environment=SNENS_API_BASE=http://127.0.0.1:7420
Environment=SNENS_API_TOKEN_FILE=%h/.local/share/snens/api.token
Environment=SNENS_WEB_DIST=%h/.local/share/snens/web
ExecStart=%h/.local/bin/snens-web
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
