[Unit]
Description=snens dev surface API (стенд, :7440)
After=network.target

[Service]
Type=simple
# Код — worktree ~/projects/snens, данные и конфиг — свои. Прод :7420 не трогает.
Environment=SNENS_CONFIG=%h/.config/snens-dev/config.toml
ExecStart=/mnt/HC_Volume_106138989/cargo-target/snens-dev/release/snens serve --config %h/.config/snens-dev/config.toml --listen 127.0.0.1:7440 --token-file %h/.local/share/snens-dev/api.token
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
