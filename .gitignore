target/
*.jsonl
bin/
# рабочие заметки инстанса: в публикацию не идут
notes/
# Бинарники тулов — сборка, не исходники. Шаблон — именно файл в корне
# каталога тула (`tools/<имя>/<имя>`), а не что угодно с таким именем:
# `tools/*/agent` без слэша в конце задевал каталог `tools/desk/agent/`,
# где лежит исходник desk-agent.ps1 — из-за этого свежий клон не собирался
# (`couldn't read tools\desk\src\../agent/desk-agent.ps1`). Пришли это
# только на Windows-сборке: локально файл лежал на диске и в git не нужен был.
# `**/` после слэша — чтобы шаблон не захватывал подкаталоги.
tools/*/read
tools/*/edit
tools/*/write
tools/*/audit
tools/*/view
tools/*/memory
tools/*/agent
tools/*/search
tools/*/fetch
tools/*/grep
tools/*/shot
tools/*/genui
tools/*/web
tools/*/desk
# Строки выше совпадают и с путями внутри тулов — после того как git один
# раз отследил файл, ignore его не отменяет, поэтому исключение ниже нужно
# ровно для нового клона. Источник агента desk — часть тула.
!tools/desk/agent/
!tools/desk/agent/desk-agent.ps1
oneoff/*/.venv/
oneoff/*/*.db
__pycache__/
*.pyc
