@echo off
rem Запуск snens на Windows 7: ядро + веб-клиент в браузере.
rem Файл в кодировке CP866 (консоль Win7), не пересохранять в UTF-8.
setlocal
set "HERE=%~dp0"
set "PORT=7420"
if not "%~1"=="" set "PORT=%~1"

rem Первый запуск: настройки (config.toml и .env с ключом) лежат в settings\
rem рядом с exe - переносим их в %APPDATA%\snens, там их ищет snens.
if not exist "%APPDATA%\snens\config.toml" if exist "%HERE%settings\config.toml" (
  if not exist "%APPDATA%\snens" mkdir "%APPDATA%\snens"
  copy /Y "%HERE%settings\config.toml" "%APPDATA%\snens\config.toml" >nul
  if exist "%HERE%settings\.env" copy /Y "%HERE%settings\.env" "%APPDATA%\snens\.env" >nul
  echo Настройки скопированы в %APPDATA%\snens
)

if not exist "%APPDATA%\snens\config.toml" (
  echo Нет настроек: %APPDATA%\snens\config.toml
  echo Смотри README.txt, раздел "Первый запуск".
  pause
  exit /b 1
)

cd /d "%HERE%"
netstat -ano | find "127.0.0.1:%PORT% " | find "LISTENING" >nul
if errorlevel 1 (
  echo Запускаю ядро snens на 127.0.0.1:%PORT% ...
  start "snens serve" "%HERE%snens.exe" serve --listen 127.0.0.1:%PORT%
) else (
  echo Ядро snens уже работает на 127.0.0.1:%PORT%
)

rem Ждём, пока ядро откроет порт (до ~20 с: на слабых машинах старт небыстрый).
rem timeout на Win7 не работает без консольного ввода, ping ждёт надёжно.
set /a TRIES=0
:wait
netstat -ano | find "127.0.0.1:%PORT% " | find "LISTENING" >nul
if not errorlevel 1 goto :ready
set /a TRIES+=1
if %TRIES% geq 20 (
  echo Ядро не открыло порт %PORT% за 20 секунд - смотри окно "snens serve".
  pause
  exit /b 1
)
ping -n 2 127.0.0.1 >nul
goto :wait
:ready

rem Код подключения браузера берём у ядра и передаём в адресе (#pair=...):
rem клиент подключится сам. Код живёт 5 минут и годится один раз.
set "CODE="
for /f "tokens=2 delims=:" %%C in ('snens.exe pair --endpoint http://127.0.0.1:%PORT% ^| findstr /r "[0-9][0-9][0-9]-[0-9][0-9][0-9]"') do set "CODE=%%C"
if defined CODE set "CODE=%CODE: =%"

set "URL=http://127.0.0.1:%PORT%/"
if defined CODE (
  set "URL=http://127.0.0.1:%PORT%/#pair=%CODE%"
  echo Код подключения: %CODE%
)
set "BROWSER="
if exist "%LOCALAPPDATA%\Supermium\supermium.exe" set "BROWSER=%LOCALAPPDATA%\Supermium\supermium.exe"
if not defined BROWSER if exist "%ProgramFiles%\Supermium\supermium.exe" set "BROWSER=%ProgramFiles%\Supermium\supermium.exe"
if not defined BROWSER if exist "%ProgramFiles%\Mozilla Firefox\firefox.exe" set "BROWSER=%ProgramFiles%\Mozilla Firefox\firefox.exe"
if not defined BROWSER if exist "%ProgramFiles(x86)%\Mozilla Firefox\firefox.exe" set "BROWSER=%ProgramFiles(x86)%\Mozilla Firefox\firefox.exe"

if defined BROWSER (
  start "" "%BROWSER%" "%URL%"
) else (
  start "" "%URL%"
)
echo Браузер открыт: http://127.0.0.1:%PORT%/
echo Ядро работает в окне "snens serve". Закрыть его = остановить snens.
pause
