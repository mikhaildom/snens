#!/bin/sh
# snens-priv — root-owned брокер привилегированных действий агента snens.
#
# Зачем брокер, а не россыпь строк в sudoers. Матчинг аргументов в sudoers
# точный и легко ошибочный; whitelist в одном исполняемом файле виден целиком,
# читается глазами и одинаково понимается и человеком, и тестом. Ставится
# root:root 0755 в /usr/local/bin/snens-priv и единственной строкой разрешается
# в /etc/sudoers.d/snens-priv — агент этот файл не правит (нет прав).
#
# Границы: набор действий фиксирован, аргументы валидируются, свободного
# root-шелла не даёт. Опасное `sudo tee /etc/...`, `cp` в /etc и широкий
# `apt-get install` намеренно не разрешены — их делает человек.
#
# ЧТО РАЗРЕШЕНО — не в этом файле, а в конфиге рядом: /etc/snens-priv.conf
# (или $SNENS_PRIV_CONF). Без конфига не разрешено ничего — установка по
# умолчанию никому ничего не выдаёт:
#
#     units = "caddy my-app"          # юниты systemd (--user), которые можно дёргать
#     roots = "/var/www /srv/data"    # корни, где разрешены mkdir -p и chown
#     owner = "deploy:deploy"         # единственный владелец для chown
#
# Валидация без выполнения: SNENS_PRIV_DRYRUN=1 snens-priv <действие> … — печатает
# «ok: <команда>» и выходит 0, либо отказывает кодом 2. Для тестов.
set -eu
# PATH фиксируем: брокер — root-граница, и `sed`/`tr` в conf_get не должны
# резолвиться из PATH вызывающего (иначе это произвольное исполнение от root).
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# Конфиг — и есть граница прав, поэтому он не должен перенаправляться окружением
# и не должен быть доступен на запись кому-то, кроме root.
# 1) под euid 0 (в т.ч. через sudo) SNENS_PRIV_CONF игнорируется;
# 2) файл обязан принадлежать root (или самому вызывающему в dryrun-режиме) и
#    быть недоступен на запись группе/others — иначе whitelist правит любой.
if [ "$(id -u)" = 0 ]; then
    CONF=/etc/snens-priv.conf
else
    CONF="${SNENS_PRIV_CONF:-/etc/snens-priv.conf}"
fi
if [ -e "$CONF" ]; then
    [ -f "$CONF" ] || { echo "snens-priv: конфиг не файл: $CONF" >&2; exit 2; }
    _conf_uid="$(stat -c '%u' "$CONF" 2>/dev/null || echo -1)"
    # Не-root вызывает брокер только для dryrun (реальные действия требуют
    # root): там конфиг может быть своим собственным, но всё равно не чужим.
    if [ "$(id -u)" = 0 ]; then
        [ "$_conf_uid" = 0 ] ||
            { echo "snens-priv: конфиг не принадлежит root: $CONF" >&2; exit 2; }
    else
        [ "$_conf_uid" = 0 ] || [ "$_conf_uid" = "$(id -u)" ] ||
            { echo "snens-priv: конфиг принадлежит не тебе и не root: $CONF" >&2; exit 2; }
    fi
    [ -z "$(find "$CONF" -maxdepth 0 -perm /022 -print 2>/dev/null)" ] ||
        { echo "snens-priv: конфиг доступен на запись не владельцу: $CONF" >&2; exit 2; }
fi

die() {
    echo "snens-priv: $*" >&2
    exit 2
}

# Значение ключа из конфига: `ключ = "значение"` или `ключ = значение`.
# Читается построчно, без `source` — конфиг не должен уметь исполняться.
#
# Хвостовой комментарий (#) отрезается и вне кавычек, и после закрывающей:
# документированный стиль `units = "caddy my-app"  # юниты` иначе давал бы
# значение вместе с комментарием, и whitelist молча не совпадал бы ни с чем.
conf_get() {
    [ -f "$CONF" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '' | '#'*) continue ;;
        esac
        key=$(printf '%s' "$line" | sed -n 's/^[[:space:]]*\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\1/p')
        [ "$key" = "$1" ] || continue
        value=$(printf '%s' "$line" | sed -n 's/^[^=]*=[[:space:]]*//p')
        case "$value" in
            '"'*)
                # Всё до второй кавычки: `#` внутри значения останется.
                rest=${value#\"}
                value=${rest%%\"*} ;;
            "'"*)
                rest=${value#\'}
                value=${rest%%\'*} ;;
            *)
                value=${value%%#*} ;;
        esac
        # Хвостовые пробелы/табы — не часть значения.
        printf '%s' "$value" | sed 's/[[:space:]]*$//'
        return 0
    done <"$CONF"
}

UNITS=" $(conf_get units) "
ROOTS="$(conf_get roots)"
OWNER="$(conf_get owner)"

[ -n "$(printf '%s' "$UNITS" | tr -d ' ')" ] || [ -n "$ROOTS" ] || [ -n "$OWNER" ] ||
    die "не настроено ничего: заполни $CONF (units/roots/owner), см. deploy/snens-priv.conf.example"

# Юнит из списка `units = "a b c"`. Принимаем и имя с суффиксом `.service`:
# человек пишет как привык, а агент зовёт и так, и так.
allowed_unit() {
    # Пустое имя проходило бы насквозь: `UNITS` уже с пробелами по краям, и
    # шаблон `*" "$1" "*` при пустом `$1` превращается в `*  *` — совпадает
    # всегда.
    [ -n "$1" ] || return 1
    case " $UNITS " in
        *" $1 "*) return 0 ;;
    esac
    case "$1" in
        *.service) allowed_unit "${1%.service}" ;;
        *) return 1 ;;
    esac
}

# Каталоги, где агенту разрешена запись/смена владельца. Без выходов вверх (..)
# и только с префиксом: иначе `mkdir -p /var/www/../../etc/x` обошёл бы границу.
allowed_path() {
    case "$1" in
        *..* | '') return 1 ;;
        # Только абсолютный: относительный путь разрешился бы от cwd брокера.
        /*) : ;;
        *) return 1 ;;
    esac
    # Текстовая проверка `..` не спасает от симлинков: если под разрешённым
    # корнем есть ссылка наружу (`/var/www/site/link -> /etc`), то
    # `mkdir -p /var/www/site/link/x` создал бы /etc/x от root, а `chown` по
    # ссылке сменил бы владельца чужого файла. Поэтому сравниваем РАЗРЕШЁННЫЕ
    # пути: `realpath -m` достраивает несуществующие хвосты, не трогая диск.
    _target="$(realpath -m -- "$1" 2>/dev/null)" || return 1
    [ -n "$_target" ] || return 1
    for root in $ROOTS; do
        _root="$(realpath -m -- "$root" 2>/dev/null)" || continue
        [ -n "$_root" ] || continue
        case "$_target" in
            "$_root" | "$_root"/*) return 0 ;;
        esac
    done
    return 1
}

run() {
    if [ "${SNENS_PRIV_DRYRUN:-}" = 1 ]; then
        echo "ok: $*"
        exit 0
    fi
    exec "$@"
}

action=${1:-}
[ -n "$action" ] || die "не задано действие (systemctl|mkdir|chown)"
shift

case "$action" in
    systemctl)
        verb=${1:-}
        unit=${2:-}
        case "$verb" in
            restart | reload | start | stop | status) ;;
            *) die "недопустимый глагол systemctl: '$verb'" ;;
        esac
        [ "$#" -eq 2 ] || die "systemctl: ожидалось ровно 2 аргумента"
        allowed_unit "$unit" || die "юнит не разрешён: '$unit' (список в $CONF)"
        # --no-pager: `status` иначе открывает пейджер и висит без терминала.
        run /usr/bin/systemctl --no-pager "$verb" "$unit"
        ;;
    mkdir)
        [ "${1:-}" = "-p" ] || die "mkdir поддерживается только с -p"
        shift
        [ "$#" -ge 1 ] || die "mkdir: нужен хотя бы один путь"
        for p in "$@"; do
            allowed_path "$p" || die "путь вне разрешённых корней: '$p' (список в $CONF)"
        done
        run /usr/bin/mkdir -p "$@"
        ;;
    chown)
        recursive=0
        if [ "${1:-}" = "-R" ]; then
            recursive=1
            shift
        fi
        spec=${1:-}
        path=${2:-}
        [ "$#" -eq 2 ] || die "chown: ожидался <владелец> <путь>"
        [ -n "$OWNER" ] || die "chown не настроен: задай owner в $CONF"
        # Пустой owner в конфиге не должен совпасть с пустым аргументом.
        [ "$spec" = "$OWNER" ] || die "владелец не разрешён: '$spec' (в конфиге '$OWNER')"
        allowed_path "$path" || die "путь вне разрешённых корней: '$path' (список в $CONF)"
        if [ "$recursive" = 1 ]; then
            run /usr/bin/chown -R "$spec" "$path"
        else
            run /usr/bin/chown "$spec" "$path"
        fi
        ;;
    *)
        die "действие не разрешено: '$action'"
        ;;
esac
