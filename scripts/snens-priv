#!/bin/sh
# snens-priv — root-owned брокер привилегированных действий агента snens.
#
# Зачем брокер, а не россыпь строк в sudoers. Матчинг аргументов в sudoers
# точный и легко ошибочный; whitelist в одном исполняемом файле виден целиком,
# читается глазами и одинаково понимается и человеком, и тестом. Ставится
# root:root 0755 в /usr/local/bin/snens-priv и единственной строкой разрешается
# в /etc/sudoers.d/snens-priv — агент этот файл не правит (нет прав).
#
# Границы: набор действий фиксирован, аргументы валидируются, свободного
# root-шелла не даёт. Опасное `sudo tee /etc/...`, `cp` в /etc и широкий
# `apt-get install` намеренно не разрешены — их делает человек.
#
# ЧТО РАЗРЕШЕНО — не в этом файле, а в конфиге рядом: /etc/snens-priv.conf
# (или $SNENS_PRIV_CONF). Без конфига не разрешено ничего — установка по
# умолчанию никому ничего не выдаёт:
#
#     units = "caddy my-app"          # юниты systemd (--user), которые можно дёргать
#     roots = "/var/www /srv/data"    # корни, где разрешены mkdir -p и chown
#     owner = "deploy:deploy"         # единственный владелец для chown
#
# Валидация без выполнения: SNENS_PRIV_DRYRUN=1 snens-priv <действие> … — печатает
# «ok: <команда>» и выходит 0, либо отказывает кодом 2. Для тестов.
set -eu

CONF="${SNENS_PRIV_CONF:-/etc/snens-priv.conf}"

die() {
    echo "snens-priv: $*" >&2
    exit 2
}

# Значение ключа из конфига: `ключ = "значение"` или `ключ = значение`.
# Читается построчно, без `source` — конфиг не должен уметь исполняться.
conf_get() {
    [ -f "$CONF" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '' | '#'*) continue ;;
        esac
        key=$(printf '%s' "$line" | sed -n 's/^[[:space:]]*\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\1/p')
        [ "$key" = "$1" ] || continue
        printf '%s' "$line" | sed -n 's/^[^=]*=[[:space:]]*//p' | sed 's/^"\(.*\)"$/\1/; s/^'"'"'\(.*\)'"'"'$/\1/'
        return 0
    done <"$CONF"
}

UNITS=" $(conf_get units) "
ROOTS="$(conf_get roots)"
OWNER="$(conf_get owner)"

[ -n "$(printf '%s' "$UNITS" | tr -d ' ')" ] || [ -n "$ROOTS" ] || [ -n "$OWNER" ] ||
    die "не настроено ничего: заполни $CONF (units/roots/owner), см. deploy/snens-priv.conf.example"

# Юнит из списка `units = "a b c"`. Принимаем и имя с суффиксом `.service`:
# человек пишет как привык, а агент зовёт и так, и так.
allowed_unit() {
    case " $UNITS " in
        *" $1 "*) return 0 ;;
    esac
    case "$1" in
        *.service) allowed_unit "${1%.service}" ;;
        *) return 1 ;;
    esac
}

# Каталоги, где агенту разрешена запись/смена владельца. Без выходов вверх (..)
# и только с префиксом: иначе `mkdir -p /var/www/../../etc/x` обошёл бы границу.
allowed_path() {
    case "$1" in
        *..*) return 1 ;;
    esac
    for root in $ROOTS; do
        case "$1" in
            "$root" | "$root"/*) return 0 ;;
        esac
    done
    return 1
}

run() {
    if [ "${SNENS_PRIV_DRYRUN:-}" = 1 ]; then
        echo "ok: $*"
        exit 0
    fi
    exec "$@"
}

action=${1:-}
[ -n "$action" ] || die "не задано действие (systemctl|mkdir|chown)"
shift

case "$action" in
    systemctl)
        verb=${1:-}
        unit=${2:-}
        case "$verb" in
            restart | reload | start | stop | status) ;;
            *) die "недопустимый глагол systemctl: '$verb'" ;;
        esac
        [ "$#" -eq 2 ] || die "systemctl: ожидалось ровно 2 аргумента"
        allowed_unit "$unit" || die "юнит не разрешён: '$unit' (список в $CONF)"
        run /usr/bin/systemctl "$verb" "$unit"
        ;;
    mkdir)
        [ "${1:-}" = "-p" ] || die "mkdir поддерживается только с -p"
        shift
        [ "$#" -ge 1 ] || die "mkdir: нужен хотя бы один путь"
        for p in "$@"; do
            allowed_path "$p" || die "путь вне разрешённых корней: '$p' (список в $CONF)"
        done
        run /usr/bin/mkdir -p "$@"
        ;;
    chown)
        recursive=0
        if [ "${1:-}" = "-R" ]; then
            recursive=1
            shift
        fi
        spec=${1:-}
        path=${2:-}
        [ "$#" -eq 2 ] || die "chown: ожидался <владелец> <путь>"
        [ -n "$OWNER" ] || die "chown не настроен: задай owner в $CONF"
        # Пустой owner в конфиге не должен совпасть с пустым аргументом.
        [ "$spec" = "$OWNER" ] || die "владелец не разрешён: '$spec' (в конфиге '$OWNER')"
        allowed_path "$path" || die "путь вне разрешённых корней: '$path' (список в $CONF)"
        if [ "$recursive" = 1 ]; then
            run /usr/bin/chown -R "$spec" "$path"
        else
            run /usr/bin/chown "$spec" "$path"
        fi
        ;;
    *)
        die "действие не разрешено: '$action'"
        ;;
esac
