#!/bin/sh
# Dev-стенд snens: тот же код из ~/projects/snens, но свои данные (:7440) и
# свои логи. Нужен, чтобы проверять правки поверхности, не трогая прод :7420.
set -eu
REPO="$HOME/projects/snens"
TARGET=/mnt/HC_Volume_106138989/cargo-target/snens-dev
BIN="$TARGET/release/snens"
CFG="$HOME/.config/snens-dev/config.toml"
DATA="$HOME/.local/share/snens-dev"
TOKEN="$DATA/api.token"
PORT="${SNENS_DEV_PORT:-7440}"

usage() {
    cat <<'EOF'
snens-dev — стенд разработки (прод :7420 не трогается)

  snens-dev build     собрать бинарь в cargo-target/snens-dev
  snens-dev start     (пере)запустить на 127.0.0.1:7440
  snens-dev stop      остановить
  snens-dev status    порт, pid, ответ /v1/model
  snens-dev logs      хвост лога
  snens-dev web       vite на :5174, прокси в :7440

Данные: ~/.local/share/snens-dev, конфиг: ~/.config/snens-dev/config.toml
EOF
}

pid_of() {
    ss -ltnp 2>/dev/null | grep ":$PORT " | grep -o 'pid=[0-9]*' | cut -d= -f2 | head -1
}

case "${1:-status}" in
build)
    cd "$REPO"
    CARGO_TARGET_DIR="$TARGET" cargo build --release --bin snens
    ;;
start)
    [ -x "$BIN" ] || { echo "нет $BIN — сначала snens-dev build" >&2; exit 1; }
    old=$(pid_of || true)
    [ -n "${old:-}" ] && kill "$old" 2>/dev/null && sleep 1
    setsid "$BIN" serve --config "$CFG" --listen "127.0.0.1:$PORT" --token-file "$TOKEN" \
        </dev/null >>"$DATA/serve.log" 2>&1 &
    sleep 2
    code=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $(cat "$TOKEN")" \
        "http://127.0.0.1:$PORT/v1/model" || true)
    echo "snens-dev :$PORT → HTTP $code (лог: $DATA/serve.log)"
    ;;
stop)
    p=$(pid_of || true)
    if [ -n "${p:-}" ]; then kill "$p" && echo "остановлен pid $p"; else echo "не запущен"; fi
    ;;
status)
    p=$(pid_of || true)
    echo "порт :$PORT pid: ${p:-нет}"
    curl -s -o /dev/null -w 'api: %{http_code}\n' -H "Authorization: Bearer $(cat "$TOKEN" 2>/dev/null)" \
        "http://127.0.0.1:$PORT/v1/model" || true
    ;;
logs)
    tail -n "${2:-40}" "$DATA/serve.log"
    ;;
web)
    cd "$HOME/projects/snens-web"
    killvite=$(pgrep -f 'node .*node_modules/.bin/vite' | head -1 || true)
    [ -n "${killvite:-}" ] && kill "$killvite" 2>/dev/null && sleep 1
    SNENS_API_BASE="http://127.0.0.1:$PORT" SNENS_API_TOKEN_FILE="$TOKEN" \
        setsid npx vite </dev/null >/tmp/snens-dev-vite.log 2>&1 &
    sleep 4
    echo "vite: http://100.73.69.107:5174 → /api :$PORT (лог: /tmp/snens-dev-vite.log)"
    ;;
-h|--help|help) usage ;;
*) usage; exit 2 ;;
esac
