{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snens",
  "version": "0.3.1",
  "identifier": "ch.svuvi.snens",
  "build": {
    "frontendDist": "resources/web"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/snens"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/tools/": "tools/",
      "resources/web/": "web/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://snens.svuvi.ch/releases/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEM0IzQUNCREJERjQ2NzQKUldSMFJ0L2J5em83cmF0dFE5dDV1Uk0zU0VJZDBVNnp3VEhGSkFUbTVLeUxjOEdxN3U1NjBud08K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
