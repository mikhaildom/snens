{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snens",
  "version": "0.1.0",
  "identifier": "ch.svuvi.snens",
  "build": {
    "frontendDist": "../snens-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "snens",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../snens-web/dist/": "web/"
    },
    "externalBin": ["binaries/snens", "binaries/memory"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://releases.svuvi.ch/snens/latest.json"],
      "pubkey": ""
    }
  }
}
