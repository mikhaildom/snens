{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snens",
  "version": "0.1.0",
  "identifier": "ch.svuvi.snens",
  "build": {
    "frontendDist": "resources/web"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/snens",
      "binaries/memory"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.svuvi.ch/snens/latest.json"
      ],
      "pubkey": ""
    }
  }
}
